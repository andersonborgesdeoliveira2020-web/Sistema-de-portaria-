<!DOCTYPE html>
<html lang="pt-BR" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="cache-control" content="no-cache, must-revalidate, post-check=0, pre-check=0">
    <meta http-equiv="expires" content="0">
    <meta http-equiv="pragma" content="no-cache">
    
    <title>Sistema Portaria - Vicon</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 15px; background-color: #ff0000; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
        .header { text-align: center; color: white; margin-bottom: 20px; }
        .header h1 { margin: 0; font-size: 40px; font-weight: bold; letter-spacing: 2px; }
        .header p { margin: 5px 0 0; font-size: 18px; text-transform: uppercase; }
        
        .container { background-color: #ffffff; padding: 20px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); width: 100%; max-width: 600px; margin-bottom: 20px; box-sizing: border-box; }
        h2 { margin-top: 0; color: #333; text-align: center; }
        h3 { color: #555; border-bottom: 2px solid #e0e0e0; padding-bottom: 5px; }
        
        /* Menu de Abas */
        .abas-menu { display: flex; margin-bottom: 20px; background-color: #eee; border-radius: 5px; padding: 5px; }
        .aba-btn { flex: 1; padding: 10px; border: none; background: none; cursor: pointer; font-size: 15px; font-weight: bold; color: #555; border-radius: 5px; }
        .aba-btn.ativa { background-color: #2c3e50; color: white; }
        .aba-conteudo { display: none; }
        .aba-conteudo.ativa { display: block; }

        /* Formulários */
        label { display: block; margin-bottom: 5px; color: #333; font-weight: bold; }
        input[type="text"], select { width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; font-size: 16px; }
        
        button.btn-salvar { background-color: #2c3e50; color: white; width: 100%; padding: 12px; border: none; border-radius: 5px; font-size: 16px; font-weight: bold; cursor: pointer; }
        button.btn-salvar:hover { background-color: #1a252f; }

        /* Tabela */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; font-size: 14px; }
        th { background-color: #f2f2f2; color: #333; }
        .btn-saida { background-color: #e67e22; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; font-weight: bold; }
        .btn-saida:hover { background-color: #d35400; }
    </style>
</head>
<body>

    <div class="header">
        <h1>VICON</h1>
        <p>Máquinas Agrícolas</p>
    </div>

    <div class="container">
        <h2>Controle de Acesso</h2>
        
        <div class="abas-menu">
            <button class="aba-btn ativa" id="btn-portaria" onclick="mudarAba('portaria')">Portaria Geral</button>
            <button class="aba-btn" id="btn-patio" onclick="mudarAba('patio')">Recebimento / Coleta</button>
        </div>

        <div id="aba-portaria" class="aba-conteudo ativa">
            <form id="formPortaria" onsubmit="salvarPortaria(event)">
                <h3>Cadastro de Acesso</h3>
                
                <label for="tipo">Tipo de Cadastro:</label>
                <select id="tipo" required onchange="ajustarCamposPortaria()">
                    <option value="Visitante">Visitante</option>
                    <option value="Prestador">Prestador de Serviço</option>
                    <option value="Funcionário">Funcionário</option>
                </select>

                <label for="nome">Nome Completo:</label>
                <input type="text" id="nome" required placeholder="Ex: João Silva">

                <label for="documento">CPF ou RG:</label>
                <input type="text" id="documento" required placeholder="Digite o documento">

                <div id="campo-empresa" style="display: none;">
                    <label for="empresa">Empresa / Transportadora:</label>
                    <input type="text" id="empresa" placeholder="Nome da empresa">
                </div>

                <div id="campo-matricula" style="display: none;">
                    <label for="matricula">RE / Matrícula:</label>
                    <input type="text" id="matricula" placeholder="Digite o RE">
                </div>

                <label for="destino">Destino / Setor / Quem vai visitar:</label>
                <input type="text" id="destino" required placeholder="Ex: RH / Engenharia / Almoxarifado">

                <button type="submit" class="btn-salvar">Registrar Entrada</button>
            </form>
        </div>

        <div id="aba-patio" class="aba-conteudo">
            <h3>Controle de Caminhões</h3>
            <p style="color: #666;">Aba do Pátio limpa. Pronta para receber as configurações de Recebimento e Coleta.</p>
        </div>
    </div>

    <div class="container" style="max-width: 850px;">
        <h3 id="tituloTabela" style="margin-top:0;">Pessoas no Interior da Empresa</h3>
        <table id="tabelaDados">
            <thead id="cabecalhoTabela">
                <tr>
                    <th>Tipo</th>
                    <th>Nome</th>
                    <th>Documento</th>
                    <th>Empresa/RE</th>
                    <th>Destino</th>
                    <th>Entrada</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="corpoTabela">
                </tbody>
        </table>
    </div>

    <script>
        // Carrega os dados salvos no navegador ou inicia vazio
        let dadosPortaria = JSON.parse(localStorage.getItem('novo_vicon_portaria')) || [];

        window.onload = function() {
            atualizarTabelaPortaria();
        };

        // Alterna campos de funcionário e prestador
        function ajustarCamposPortaria() {
            const tipo = document.getElementById('tipo').value;
            const divEmpresa = document.getElementById('campo-empresa');
            const divMatricula = document.getElementById('campo-matricula');

            if (tipo === 'Prestador') {
                divEmpresa.style.display = 'block';
                divMatricula.style.display = 'none';
            } else if (tipo === 'Funcionário') {
                divEmpresa.style.display = 'none';
                divMatricula.style.display = 'block';
            } else {
                divEmpresa.style.display = 'none';
                divMatricula.style.display = 'none';
            }
        }

        function mudarAba(aba) {
            document.querySelectorAll('.aba-btn').forEach(b => b.classList.remove('ativa'));
            document.querySelectorAll('.aba-conteudo').forEach(c => c.classList.remove('ativa'));

            if (aba === 'portaria') {
                document.getElementById('btn-portaria').classList.add('ativa');
                document.getElementById('aba-portaria').classList.add('ativa');
                document.getElementById('tituloTabela').innerText = "Pessoas no Interior da Empresa";
                atualizarTabelaPortaria();
            } else {
                document.getElementById('btn-patio').classList.add('ativa');
                document.getElementById('aba-patio').classList.add('ativa');
                document.getElementById('tituloTabela').innerText = "Fluxo de Veículos (Pátio)";
                document.getElementById('cabecalhoTabela').innerHTML = `<tr><th>Operação</th><th>Motorista</th><th>Placa</th><th>Status</th></tr>`;
                document.getElementById('corpoTabela').innerHTML = `<tr><td colspan="4" style="text-align:center; color:#999;">Aba pátio em desenvolvimento...</td></tr>`;
            }
        }

        function obtenerHoraAtual() {
            const agora = new Date();
            return agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        }

        function salvarPortaria(event) {
            event.preventDefault();

            const tipo = document.getElementById('tipo').value;
            let infoAdicional = "-";
            
            if (tipo === 'Prestador') {
                infoAdicional = document.getElementById('empresa').value || "Não informada";
            } else if (tipo === 'Funcionário') {
                infoAdicional = "RE: " + (document.getElementById('matricula').value || "Não informado");
            }

            const novoRegistro = {
                tipo: tipo,
                nome: document.getElementById('nome').value,
                documento: document.getElementById('documento').value,
                detalhe: infoAdicional,
                destino: document.getElementById('destino').value,
                hora: obtenerHoraAtual()
            };

            dadosPortaria.push(novoRegistro);
            localStorage.setItem('novo_vicon_portaria', JSON.stringify(dadosPortaria));
            
            atualizarTabelaPortaria();
            document.getElementById('formPortaria').reset();
            ajustarCamposPortaria();
        }

        function registrarSaida(index) {
            dadosPortaria.splice(index, 1);
            localStorage.setItem('novo_vicon_portaria', JSON.stringify(dadosPortaria));
            atualizarTabelaPortaria();
        }

        function atualizarTabelaPortaria() {
            document.getElementById('cabecalhoTabela').innerHTML = `<tr><th>Tipo</th><th>Nome</th><th>Documento</th><th>Empresa/RE</th><th>Destino</th><th>Entrada</th><th>Ações</th></tr>`;
            const tabela = document.getElementById('corpoTabela');
            tabela.innerHTML = "";

            if (dadosPortaria.length === 0) {
                tabela.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#999;">Ninguém no interior da empresa no momento.</td></tr>`;
                return;
            }

            dadosPortaria.forEach((reg, index) => {
                const linha = document.createElement('tr');
                linha.innerHTML = `
                    <td><strong>${reg.tipo}</strong></td>
                    <td>${reg.nome}</td>
                    <td>${reg.documento}</td>
                    <td>${reg.detalhe}</td>
                    <td>${reg.destino}</td>
                    <td>${reg.hora}</td>
                    <td><button class="btn-saida" onclick="registrarSaida(${index})">Saída</button></td>
                `;
                tabela.appendChild(linha);
            });
        }
    </script>
</body>
</html>
